# #Created By AiCoding(codex) 环境变量示例：复制为 .env 后修改（.env 不要提交）
DATA_DIR=./data

# 大模型（OpenAI 兼容接口）
LLM_BASE_URL=http://llm-gateway.example.internal/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0
# 内网推理服务不支持时设为 false
# LLM_STRICT_TOOLS=false
# LLM_TOOL_CHOICE_REQUIRED=false

# 智能体与平台工具（以下数值/枚举项留空将自动回退内置默认值，且均可在工作台「引擎与系统设置」在线热更新）
# 交卷方式：
#   json_object = Schema 写进提示词 + response_format=json_object（DeepSeek 官方 API 用这个）
#   tool        = 调用 submit_report 工具交卷（支持 function calling 的服务都能用）
#   native      = response_format=json_schema（推理服务支持 json_schema 时可用）
#   prompted    = 只靠提示词约束，不发送 response_format
AGENT_OUTPUT_MODE=tool
AGENT_NATIVE_STRICT=true
AGENT_OUTPUT_RETRIES=3
AGENT_REQUEST_LIMIT=25
# 平台工具限额（均可在工作台 引擎与系统设置 在线热更新，留空回退默认值）
# query_result 未指定 limit 时的默认返回行数（默认 20，范围 1~500）
AGENT_QUERY_DEFAULT_LIMIT=20
# query_result 单次允许返回的最大行数上限（默认 100，范围 1~1000，需 >= AGENT_QUERY_DEFAULT_LIMIT）
AGENT_QUERY_MAX_LIMIT=100
# expand_period 单次允许展开的最大月份跨度（默认 36，范围 1~120）
AGENT_MAX_PERIOD_MONTHS=36

# 嵌入式聊天与上下文压缩（均可在工作台 引擎与系统设置 在线热更新，留空自动回退内置默认值）
# 聊天窗口注入提示词的单据正文最大字符数（默认 12000，范围 500~200000）
CHAT_MAX_DOC_CHARS=12000
# 聊天窗口单轮携带的最近原文消息最大条数（默认 20，范围 1~200）
CHAT_MAX_HISTORY_MESSAGES=20
# 聊天窗口注入上下文的最近运行卡片数量上限（默认 8，范围 1~50）
CHAT_MAX_RUN_CARDS=8
# 聊天窗口运行卡片报告正文预览截断字符数（默认 1500，范围 100~20000）
CHAT_MAX_MARKDOWN_PREVIEW_CHARS=1500
# 自动触发增量滚动上下文压缩的未归档消息阈值（默认 24，范围 2~500，需 > CHAT_COMPACT_KEEP_RECENT）
CHAT_COMPACT_TRIGGER_MESSAGES=24
# 自动压缩后保留的最近原文消息条数（默认 12，范围 1~200）
CHAT_COMPACT_KEEP_RECENT=12
# 手动压缩（/compact）后保留的最近原文消息条数（默认 6，范围 1~200）
CHAT_MANUAL_COMPACT_KEEP_RECENT=6
# 手动压缩至少需可归档的最小消息条数（默认 2，范围 1~100；触发下限 = 保留条数 + 最小切片，默认 8）
CHAT_MANUAL_COMPACT_MIN_SLICE=2
# 滚动记忆摘要最大字符数上限（默认 1200，范围 200~10000）
CHAT_MAX_MEMORY_SUMMARY_CHARS=1200
# 待压缩消息单条文本截取上限（默认 800，范围 100~10000）
CHAT_MAX_SUMMARY_MSG_CHARS=800
# 聊天路由智能体单轮最多请求模型次数（默认 8，范围 1~50）
CHAT_REQUEST_LIMIT=8
# 聊天路由智能体单轮最多调用只读工具次数（默认 16，范围 1~100）
CHAT_TOOL_CALLS_LIMIT=16
# 聊天路由智能体单轮推理超时秒数（默认 120，需 > 0）
CHAT_TIMEOUT_S=120
# 滚动记忆摘要智能体单次压缩最多请求模型次数（默认 3，范围 1~20）
CHAT_SUMMARY_REQUEST_LIMIT=3
# 滚动记忆摘要智能体单次压缩最多调用工具次数（默认 4，范围 1~30）
CHAT_SUMMARY_TOOL_CALLS_LIMIT=4
# 滚动记忆摘要智能体单次压缩超时秒数（默认 60，需 > 0）
CHAT_SUMMARY_TIMEOUT_S=60

# 统一网关：mock 读取 data/mock-gateway；live 调用真实网关
GATEWAY_MODE=mock
GATEWAY_URL=
GATEWAY_APP_ID=
GATEWAY_ACCESS_TOKEN=
GATEWAY_XML_STYLE=java

# 上游调用 /api/v1/reports 的 API Key（逗号分隔，为空不校验）
REPORT_API_KEYS=

# 管理端
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_TOKEN_SECRET=
# FRONTEND_DIST=frontend/dist
