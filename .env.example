# #Created By AiCoding(codex) 环境变量示例：复制为 .env 后修改（.env 不要提交）
DATA_DIR=./data

# 大模型（OpenAI 兼容接口）
LLM_BASE_URL=http://llm-gateway.example.internal/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0
# 内网推理服务不支持时设为 false
# LLM_STRICT_TOOLS=false
# LLM_TOOL_CHOICE_REQUIRED=false

# 智能体
# 交卷方式：
#   json_object = Schema 写进提示词 + response_format=json_object（DeepSeek 官方 API 用这个）
#   tool        = 调用 submit_report 工具交卷（支持 function calling 的服务都能用）
#   native      = response_format=json_schema（推理服务支持 json_schema 时可用）
#   prompted    = 只靠提示词约束，不发送 response_format
AGENT_OUTPUT_MODE=tool
AGENT_NATIVE_STRICT=true
AGENT_OUTPUT_RETRIES=3
AGENT_REQUEST_LIMIT=25

# 统一网关：mock 读取 data/mock-gateway；live 调用真实网关
GATEWAY_MODE=mock
GATEWAY_URL=
GATEWAY_APP_ID=
GATEWAY_ACCESS_TOKEN=
GATEWAY_XML_STYLE=java

# 上游调用 /api/v1/reports 的 API Key（逗号分隔，为空不校验）
REPORT_API_KEYS=

# 管理端
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_TOKEN_SECRET=
# FRONTEND_DIST=frontend/dist
